# latexmk config for the resume.
# Build with plain `latexmk` from this folder (or `make`).

# Use pdflatex: the template relies on \pdfgentounicode and the roboto pdfTeX fonts.
$pdf_mode = 1;

# Keep the aux/log clutter out of the source folder.
$out_dir = 'build';

# Stop on errors instead of dropping into the interactive TeX prompt.
$pdflatex = 'pdflatex -interaction=nonstopmode -halt-on-error -file-line-error %O %S';

# Only build the resume, even if other .tex files appear here later.
@default_files = ('resume.tex');
